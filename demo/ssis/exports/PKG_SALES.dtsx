                  <outputColumns />
                </output>
              </outputs>
            </component>
            <component refId="Package\DFT Sales Lines\DER Web Fee" name="DER Web Fee" componentClassID="Microsoft.DerivedColumn">
              <inputs>
                <input refId="Package\DFT Sales Lines\DER Web Fee.Inputs[Derived Column Input]" name="Derived Column Input" />
              </inputs>
              <outputs>
                <output refId="Package\DFT Sales Lines\DER Web Fee.Outputs[Derived Column Output]" name="Derived Column Output">
                  <outputColumns>
                    <outputColumn refId="Package\DFT Sales Lines\DER Web Fee.Outputs[Derived Column Output].Columns[LineAmount]" name="LineAmount" lineageId="Package\DFT Sales Lines\DER Web Fee.Outputs[Derived Column Output].Columns[LineAmount]" dataType="numeric" precision="15" scale="2">
                      <properties>
                        <property name="FriendlyExpression">[LineAmount] * 1.02</property>
                      </properties>
                    </outputColumn>
