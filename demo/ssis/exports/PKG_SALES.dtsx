            <component refId="Package\DFT Sales Lines\CSPL Channel" name="CSPL Channel" componentClassID="Microsoft.ConditionalSplit">
              <inputs>
                <input refId="Package\DFT Sales Lines\CSPL Channel.Inputs[Conditional Split Input]" name="Conditional Split Input" />
              </inputs>
              <outputs>
                <output refId="Package\DFT Sales Lines\CSPL Channel.Outputs[Store]" name="Store">
                  <properties>
                    <property name="FriendlyExpression">[Channel] == "STORE"</property>
                  </properties>
                  <outputColumns />
                </output>
                <output refId="Package\DFT Sales Lines\CSPL Channel.Outputs[Web]" name="Web">
