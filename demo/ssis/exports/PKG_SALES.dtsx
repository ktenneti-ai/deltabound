      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="LoadDate" DTS:EvaluateAsExpression="True" DTS:Expression="DATEADD(&quot;day&quot;, -1, GETDATE())">
      <DTS:VariableValue DTS:DataType="7">2026-10-31</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="FullLoad">
      <DTS:VariableValue DTS:DataType="11">False</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\SQL Truncate Staging" DTS:ObjectName="SQL Truncate Staging" DTS:ExecutableType="Microsoft.ExecuteSQLTask">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="Package.ConnectionManagers[DWH]" SQLTask:SqlStatementSource="TRUNCATE TABLE stg.SalesLines" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\DFT Sales Lines" DTS:ObjectName="DFT Sales Lines" DTS:ExecutableType="Microsoft.Pipeline">
      <DTS:ObjectData>
        <pipeline version="1">
          <components>
            <component refId="Package\DFT Sales Lines\OLE_SRC Order Lines" name="OLE_SRC Order Lines" componentClassID="Microsoft.OLEDBSource">
              <properties>
                <property name="AccessMode">2</property>
                <property name="SqlCommand">SELECT OrderID, LineNo, OrderDate, CustomerID, Qty, UnitPrice, Channel FROM sales.OrderLines WHERE ModifiedDate &gt;= ?</property>
              </properties>
              <connections>
                <connection name="Connection" connectionManagerID="Package.ConnectionManagers[ERP]" />
              </connections>
              <inputs />
              <outputs>
                <output refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[OrderID]" name="OrderID" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[OrderID]" dataType="i4" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[LineNo]" name="LineNo" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[LineNo]" dataType="i4" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[OrderDate]" name="OrderDate" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[OrderDate]" dataType="dbDate" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[CustomerID]" name="CustomerID" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[CustomerID]" dataType="wstr" length="10" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[Qty]" name="Qty" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[Qty]" dataType="numeric" precision="13" scale="3" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[UnitPrice]" name="UnitPrice" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[UnitPrice]" dataType="numeric" precision="15" scale="2" />
                    <outputColumn refId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[Channel]" name="Channel" lineageId="Package\DFT Sales Lines\OLE_SRC Order Lines.Outputs[OLE DB Source Output].Columns[Channel]" dataType="wstr" length="10" />
                  </outputColumns>
                </output>
              </outputs>
            </component>
            <component refId="Package\DFT Sales Lines\DER Amounts" name="DER Amounts" componentClassID="Microsoft.DerivedColumn">
              <inputs>
                <input refId="Package\DFT Sales Lines\DER Amounts.Inputs[Derived Column Input]" name="Derived Column Input" />
              </inputs>
              <outputs>
                <output refId="Package\DFT Sales Lines\DER Amounts.Outputs[Derived Column Output]" name="Derived Column Output">
                  <outputColumns>
                    <outputColumn refId="Package\DFT Sales Lines\DER Amounts.Outputs[Derived Column Output].Columns[LineAmount]" name="LineAmount" lineageId="Package\DFT Sales Lines\DER Amounts.Outputs[Derived Column Output].Columns[LineAmount]" dataType="numeric" precision="15" scale="2">
                      <properties>
                        <property name="FriendlyExpression">[Qty] * [UnitPrice]</property>
                      </properties>
                    </outputColumn>
                    <outputColumn refId="Package\DFT Sales Lines\DER Amounts.Outputs[Derived Column Output].Columns[LoadDate]" name="LoadDate" lineageId="Package\DFT Sales Lines\DER Amounts.Outputs[Derived Column Output].Columns[LoadDate]" dataType="dbDate">
                      <properties>
                        <property name="FriendlyExpression">(DT_DBDATE)@[User::LoadDate]</property>
