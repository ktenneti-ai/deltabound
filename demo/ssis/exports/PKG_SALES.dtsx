                    <outputColumn refId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[CustomerKey]" name="CustomerKey" lineageId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[CustomerKey]" dataType="i4" />
                    <outputColumn refId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LineAmount]" name="LineAmount" lineageId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LineAmount]" dataType="numeric" />
                    <outputColumn refId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LoadDate]" name="LoadDate" lineageId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LoadDate]" dataType="dbDate" />
                  </outputColumns>
