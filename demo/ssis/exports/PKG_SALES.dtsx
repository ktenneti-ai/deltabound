                    <outputColumn refId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LineNo]" name="LineNo" lineageId="Package\DFT Sales Lines\UALL Channels.Outputs[Union All Output 1].Columns[LineNo]" dataType="i4" />
