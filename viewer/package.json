{
  "name": "deltabound-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "prepare:py": "node scripts/prepare-py.mjs",
    "gen:types": "../.venv/bin/deltabound schema --out src/ir.schema.json && json2ts -i src/ir.schema.json -o src/ir.ts --additionalProperties false",
    "dev": "npm run prepare:py && vite",
    "build": "npm run prepare:py && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.0",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
